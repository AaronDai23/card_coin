<?xml version="1.0" encoding="utf-8"?>
<!--
  Match Flutter AppSplashLogo (200dp). Slightly under the Android 12 system
  splash icon frame (~240dp) so cold-start does not jump large → small.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">
    <item android:drawable="@drawable/splash_fill_white" />
    <item
        android:width="200dp"
        android:height="200dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
