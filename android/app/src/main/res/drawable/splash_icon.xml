<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ always shows a system splash; we cannot disable it.
  Use a solid white icon so the mandatory splash is blank white — logo comes
  from Flutter SplashPage only.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/splash_fill_white" />
</layer-list>
